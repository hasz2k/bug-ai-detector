# Configuration for Jira Integration (Atlassian REST API v3)
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=BUG

# Configuration for Redmine Integration (REST API)
REDMINE_URL=https://redmine.your-domain.com
REDMINE_API_KEY=your_redmine_api_key
REDMINE_PROJECT_ID=1

# Webhook Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK

# CORS Settings (Optional - comma-separated origins)
CORS_ORIGINS=http://localhost:8085,
